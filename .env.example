# ── Сервер ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Админка ───────────────────────────────────────────────
# Bootstrap-владелец: создаётся при первом запуске (ADMIN_LOGIN + ADMIN_PASSWORD).
# Обязательно замените в продакшене! Позже владелец может сменить пароль в панели.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password
# Случайная строка длиной 32+ символов
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRES_IN=12h

# ── База данных ───────────────────────────────────────────
# Вариант 1 (по умолчанию): встроенный PostgreSQL (PGlite), без установки.
PGLITE_DATA_DIR=./data/pglite

# Каталог загруженных изображений (отдаётся по /uploads/<файл>)
UPLOAD_DIR=./uploads

# Вариант 2: обычный PostgreSQL. Раскомментируйте и укажите строку подключения.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcskill_trader

# Заполнять базу демо-ресурсами при первом запуске
SEED_ON_START=true
