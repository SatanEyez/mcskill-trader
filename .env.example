# ── Сервер ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Админка ───────────────────────────────────────────────
# Bootstrap-владелец: создаётся при первом запуске (ADMIN_LOGIN + ADMIN_PASSWORD).
# Обязательно замените в продакшене! Позже владелец может сменить пароль в панели.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password
# Случайная строка длиной 32+ символов
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRES_IN=12h

# ── База данных (MySQL) ───────────────────────────────────
# Логин/пароль к базе задаются в отдельном файле в корне проекта:
#   mysql-connection.env   (шаблон — mysql-connection.env.example)
# Его читают API, phpMyAdmin и mysql-connect.cmd.

# Каталог загруженных изображений (отдаётся по /uploads/<файл>)
UPLOAD_DIR=./uploads

# Заполнять базу демо-ресурсами при первом запуске
SEED_ON_START=true
