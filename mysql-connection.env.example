# Шаблон настроек подключения к MySQL.
# Скопируйте в mysql-connection.env и укажите свои данные:
#   Copy-Item mysql-connection.env.example mysql-connection.env

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mcskill
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=mcskill_trader
MYSQL_CONNECTION_LIMIT=10

# Облачная MySQL (Aiven, TiDB, PlanetScale, Railway) — только по TLS:
# MYSQL_SSL=true
# MYSQL_SSL_CA=C:\путь\к\ca.pem
MYSQL_SSL=false
